{
  "name": "content-unlock-log",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "preview:pages": "vite preview --base /ffxiv-contentunlockchecklist/",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "snapshot": "tsx scripts/snapshot.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "duplication": "jscpd",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run duplication && npm test"
  },
  "dependencies": {
    "node-html-parser": "^9.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jscpd": "^5.4.3",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
